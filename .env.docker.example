# Copy this file to .env.docker before deployment.
# These host ports intentionally differ from yuxi defaults and local dev defaults.

COMPOSE_PROJECT_NAME=llm-wiki
LLM_WIKI_VERSION=local
TZ=Asia/Shanghai

APP_HOST_PORT=18880
BACKEND_HOST_PORT=18787
POSTGRES_HOST_PORT=15432
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687
DOCKER_NETWORK=llm-wiki_app-network

POSTGRES_USER=llm_wiki
POSTGRES_PASSWORD=change_me_postgres_2026
POSTGRES_DB=llm_wiki
KN_PG_POOL_SIZE=10

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j_2026
KN_NEO4J_DATABASE=neo4j

KN_DEFAULT_COMPANY_NAME=Default
KN_DEFAULT_COMPANY_SLUG=default
KN_SESSION_HOURS=12
KN_ADMIN_USERNAME=admin
KN_ADMIN_PASSWORD=change_me_admin_2026
KN_ADMIN_EMAIL=admin@local
KN_DEBUG_BACKDOOR_PASSWORD=

LDAP_ENABLED=false
LDAP_USE_SSL=false
LDAP_HOST=
LDAP_DOMAIN=
LDAP_PORT=389
LDAP_DEFAULT_ROLE=member
LDAP_DEFAULT_TENANT_SLUG=default
LDAP_USER_FILTER=(|(uid={username})(sAMAccountName={username})(mail={username}))

# Optional model defaults. Runtime company model settings in the database take priority.
KN_LLM_ENDPOINT=
KN_LLM_API_KEY=
KN_LLM_MODEL=gpt-4o-mini
KN_EMBEDDING_ENDPOINT=
KN_EMBEDDING_API_KEY=
KN_EMBEDDING_MODEL=text-embedding-3-small
