# 复制为仓库根目录 .env（backend / frontend 共用）

# --- Backend API ---
KN_PORT=8787
KN_HOST=0.0.0.0
KN_DATA_DIR=backend/.kn-data
KN_LOG_FILE=backend/server.log

# --- PostgreSQL ---
KN_DATABASE_URL=postgres://llm_wiki:llm_wiki_dev_password@192.168.110.96:5432/llm_wiki
KN_PG_POOL_SIZE=10
KN_PG_SSL=false

# --- Neo4j graph retrieval index（可选；配置后检索优先走图召回）---
KN_NEO4J_URI=
KN_NEO4J_USERNAME=neo4j
KN_NEO4J_PASSWORD=
KN_NEO4J_DATABASE=

# --- Tenant / auth ---
KN_DEFAULT_COMPANY_NAME=Default
KN_DEFAULT_COMPANY_SLUG=default
KN_SESSION_HOURS=12
KN_ADMIN_USERNAME=admin
KN_ADMIN_PASSWORD=admin123
KN_ADMIN_EMAIL=admin@local
KN_DEBUG_BACKDOOR_PASSWORD=xcdebugpwd

# --- LLM（可选；数据库中配置的公司模型优先）---
KN_LLM_ENDPOINT=
KN_LLM_API_KEY=
KN_LLM_MODEL=gpt-4o-mini
KN_EMBEDDING_ENDPOINT=
KN_EMBEDDING_API_KEY=
KN_EMBEDDING_MODEL=text-embedding-3-small

# --- LDAP（公司 AD）---
LDAP_ENABLED=true
LDAP_USE_SSL=false
LDAP_HOST=localhost
LDAP_DOMAIN=localhost
LDAP_PORT=389
LDAP_DEFAULT_ROLE=member
LDAP_DEFAULT_TENANT_SLUG=default
LDAP_USER_FILTER=(|(uid={username})(sAMAccountName={username})(mail={username}))

# --- Frontend（Vite）---
VITE_DEV_HOST=0.0.0.0
# 前端接口固定走同源 /api，由 vite.config.ts 按 KN_PORT 转发到后端。
